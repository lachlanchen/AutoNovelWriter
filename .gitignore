# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Node (if introduced later)
node_modules/

# OS junk
.DS_Store
Thumbs.db
__MACOSX/
._*

# AutoNovelWriter runtime (never commit user chat/task artifacts)
autonovelwriter/runtime/io/inbox/*
autonovelwriter/runtime/io/outbox/*
autonovelwriter/runtime/logs/*
autonovelwriter/runtime/state/*
autonovelwriter/runtime/tasks/*
autonovelwriter/runtime/projects/*
autonovelwriter/runtime/actions/*

# Auto-dev driver artifacts (keep plans/steps/tasks, ignore raw codex JSONL + session/locks)
references/autonovelwriter_dev/logs/
references/autonovelwriter_dev/.codex_autonovelwriter_session
references/autonovelwriter_dev/*.lock
references/autonovelwriter_dev/state.tsv
references/autonovelwriter_dev/STOP
references/autonovelwriter_dev/steps/*/commit_body.txt

# Generated task-batch prompts (ephemeral; keep canonical prompts under T###_*.txt tracked)
references/autonovelwriter_dev/prompts/GEN_tasks_*.txt
