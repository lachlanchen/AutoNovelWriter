# AutoNovelWriter backend (development)
# Copy to a local .env (do not commit secrets) and export before running server.py

# Where runtime IO/state/log directories live
AUTONOVELWRITER_RUNTIME_ROOT=autonovelwriter/runtime

# Where static PWA files live (optional; server will only mount if it exists)
AUTONOVELWRITER_PWA_ROOT=autonovelwriter/pwa

# Bind host (default 127.0.0.1)
AUTONOVELWRITER_HOST=127.0.0.1
